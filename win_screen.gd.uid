extends Control




func _on_retry_button_pressed() -> void:
	get_tree().change_scene_to_file("res://Scenes (TAOJS)/world.tscn")


func _on_return_button_pressed() -> void:
	get_tree().change_scene_to_file("res://Scenes (TAOJS)/Title_screen.tscn")


func _on_quit_button_pressed() -> void:
	get_tree().quit()
