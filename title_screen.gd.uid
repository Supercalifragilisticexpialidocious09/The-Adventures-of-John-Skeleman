extends Control

#Changes the scene to the start of the game
func _on_start_button_pressed() -> void:
	get_tree().change_scene_to_file("res://Scenes (TAOJS)/world.tscn")

#Quits the game
func _on_quit_button_pressed() -> void:
	get_tree().quit()

#Changes the scene to the control screen
func _on_control_button_pressed() -> void:
	get_tree().change_scene_to_file("res://Scenes (TAOJS)/Control_screen.tscn")
